# m2.7 · H200 8 卡 · 固定评测口径（唯一真相）
#
# 这里的所有值都是"跨版本必须一致"的东西：模型、并行策略、显存/调度参数、
# 功能参数、压测负载。换 vLLM 版本时**不要**动这个文件，只改镜像名。
# 改动这里 = 改动全部版本的口径，历史结果将不可比 —— 所以改之前先想清楚。
#
# 口径来源：https://recipes.vllm.ai/MiniMaxAI/MiniMax-M2.7（含 strategy_overrides
# 明确写着 pure TP=8 不支持：fp8 block_n=128 不整除 1536/8=192）

# ── 模型 ──────────────────────────────────────────────────────────────
MODEL_HOST=/data/liuxin/Ax/models/MiniMax_MiniMax-M2.7
MODEL_MOUNT=/models                     # 宿主目录挂到容器内的位置
SERVED_NAME=m2.7                        # OpenAI 接口里的 model 名

# ── 并行策略 ──────────────────────────────────────────────────────────
# TP4 = recipe 的默认档（strategy_overrides.single_node_tp: tp: 4）。
# 不选 TP8+EP：EP 在 0.19/0.25 上分别撞 shm_broadcast 死锁与 custom_all_reduce
# 非法访存，跨版本稳定性太差，且无法保证每个版本都起得来 -> 数字不可比。
# 代价是只用 4 张卡，好处是所有版本同一档、结果可直接对比。
PARALLEL_NAME="TP4"
PARALLEL_ARGS="--tensor-parallel-size 4"

# ── recipe 的 performance tuning ──────────────────────────────────────
GPU_MEM_UTIL=0.95
MAX_NUM_SEQS=256
MAX_NUM_BATCHED_TOKENS=8192
# max-model-len 走 auto（recipe 口径），不要写死

# ── recipe 的 base / features ─────────────────────────────────────────
RECIPE_ARGS="--trust-remote-code --tool-call-parser minimax_m2 --reasoning-parser minimax_m2 --enable-auto-tool-choice"

# ── CUDA graph ────────────────────────────────────────────────────────
# 0.25/0.26 的图捕获在本机会非法访存（详见 ENVIRONMENT.md §3）。为了让七个版本同口径可比，
# 全平台统一关掉 CUDA graph（--enforce-eager）。代价：解码慢约 3 倍（TPOT 22→79 ms）。
ENFORCE_EAGER=${ENFORCE_EAGER:-1}

# ── 运行时环境变量（所有版本统一）────────────────────────────────────
# 这台机器的驱动/NCCL 组合不支持 NVLS 多播：带 NCCL 2.30 的新版 vLLM 在
# ncclCommInitRank 报 "NCCL error: unhandled cuda error"（0.29/0.31 实测），
# 0.26 则撞 custom_all_reduce illegal memory access。关掉 NVLS 后可正常启动。
EXTRA_ENV="NCCL_NVLS_ENABLE=0"

# vLLM 自带的 custom all-reduce kernel 在本机内核上会撞
#   custom_all_reduce.cuh:455 'an illegal memory access was encountered'
# （0.25.1 / 0.26.0 实测，关 NVLS 也照样崩）。统一关掉，退回 NCCL all-reduce：
# 有一点性能损失，但所有版本同一路径，版本间依然可比。
EXTRA_SERVE_ARGS="--disable-custom-all-reduce"

# ── 压测负载（recipe 的 benchmark 口径，固定）─────────────────────────
BACKEND=vllm
ENDPOINT=/v1/completions
DATASET=random
IN_LEN=65536      # 64k 输入（用户指定；长上下文压测）
OUT_LEN=2048      # 2k 输出
NUM_PROMPTS=32
CONCURRENCY=8

# ── 运行时 ────────────────────────────────────────────────────────────
# 默认用宿主 docker（root 已迁到 /nvme/docker，13T 空间）。
# 需要隔离时填 unix:///var/run/docker-bench.sock 之类的独立 daemon。
DOCKER_HOST_BENCH=""
# bridge = -p PORT:8000 映射（默认）；host = 容器直接用宿主网络并监听 PORT
NETWORK_MODE=bridge
PORT=19000
CONTAINER=bifrost-bench
SHM_SIZE=32g
SERVE_TIMEOUT=2400                       # 权重加载 + 图捕获上限（秒）
OUTPUT_ROOT=/data/liuxin/bifrost/bench/m2.7
IMAGES_DIR=/data/liuxin/images           # docker load 用的 tar 所在目录
KEEP_IMAGE=1                             # 空间够时保留镜像，重跑同一版本不必再 load
