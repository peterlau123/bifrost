# MiniMax-M2.7 · 2K 输入 / 1K 输出 · 与 64K 那组只改长度，其余完全一致（32 prompts / 并发 8）
MODEL_KEY=m2.7-2k1k-o1
MODEL_HOST=/data/liuxin/Ax/models/MiniMax_MiniMax-M2.7
SERVED_NAME=m2.7
PARALLEL_NAME="TP4"
PARALLEL_ARGS="--tensor-parallel-size 4"
RECIPE_ARGS="--trust-remote-code --tool-call-parser minimax_m2 --reasoning-parser minimax_m2 --enable-auto-tool-choice"
EXTRA_SERVE_ARGS="--disable-custom-all-reduce -O1"
OUTPUT_ROOT=/data/liuxin/bifrost/bench/m2.7-2k1k-o1

IN_LEN=2048
OUT_LEN=1024
NUM_PROMPTS=32
CONCURRENCY=8
