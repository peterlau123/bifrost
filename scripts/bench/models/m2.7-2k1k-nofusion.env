# MiniMax-M2.7 · 64K/2K/并发8 · graph 模式 + 上游 workaround（关闭 allreduce+rmsnorm 融合）
# 依据: vllm#49311 / #48071，PR #48075（NVLink 无双播时 mnnvl fused allreduce 在 graph 捕获阶段越界）
MODEL_KEY=m2.7-2k1k-nofusion
MODEL_HOST=/data/liuxin/Ax/models/MiniMax_MiniMax-M2.7
SERVED_NAME=m2.7
PARALLEL_NAME="TP4"
PARALLEL_ARGS="--tensor-parallel-size 4"
RECIPE_ARGS="--trust-remote-code --tool-call-parser minimax_m2 --reasoning-parser minimax_m2 --enable-auto-tool-choice"
EXTRA_SERVE_ARGS='--disable-custom-all-reduce --compilation-config {"pass_config":{"fuse_allreduce_rms":false}}'
OUTPUT_ROOT=/data/liuxin/bifrost/bench/m2.7-2k1k-nofusion

IN_LEN=2048
OUT_LEN=1024
NUM_PROMPTS=32
CONCURRENCY=8
