# MiniMax-M2.7 · fp8 分块量化 MoE · recipe: https://recipes.vllm.ai/MiniMaxAI/MiniMax-M2.7
MODEL_KEY=m2.7
MODEL_HOST=/data/liuxin/Ax/models/MiniMax_MiniMax-M2.7
SERVED_NAME=m2.7
PARALLEL_NAME="TP4"                      # TP8 不成立：1536/8=192 不整除 block_n=128
PARALLEL_ARGS="--tensor-parallel-size 4"
RECIPE_ARGS="--trust-remote-code --tool-call-parser minimax_m2 --reasoning-parser minimax_m2 --enable-auto-tool-choice"
EXTRA_SERVE_ARGS="--disable-custom-all-reduce"
OUTPUT_ROOT=/data/liuxin/bifrost/bench/m2.7
