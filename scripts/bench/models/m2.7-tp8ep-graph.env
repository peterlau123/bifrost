# m2.7 · 8 卡满配 TP8+EP + CUDA Graph（含 allreduce+rmsnorm 融合关闭的 workaround）
# 口径与 TP4 graph 组完全一致：in=65536 out=2048 prompts=32 concurrency=8
MODEL_KEY=m2.7-tp8ep-graph
MODEL_HOST=/data/liuxin/Ax/models/MiniMax_MiniMax-M2.7
SERVED_NAME=m2.7
PARALLEL_NAME="TP8+EP"
PARALLEL_ARGS="--tensor-parallel-size 8 --enable-expert-parallel"
RECIPE_ARGS="--trust-remote-code --tool-call-parser minimax_m2 --reasoning-parser minimax_m2 --enable-auto-tool-choice"
EXTRA_SERVE_ARGS='--disable-custom-all-reduce --compilation-config {"pass_config":{"fuse_allreduce_rms":false}}'
OUTPUT_ROOT=/data/liuxin/bifrost/bench/m2.7-tp8ep-graph

IN_LEN=65536
OUT_LEN=2048
NUM_PROMPTS=32
CONCURRENCY=8
