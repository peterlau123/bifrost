# MiniMax-M2.7 · 8 卡满配：TP8 + EP + 关 CUDA graph · recipe 负载
# 实测（v0.31.0）：KV 3.5M tokens / 103.56 GiB per GPU，/health 200 正常。
# 注意：0.17/0.19 的 EP 曾出现 shm_broadcast 死锁，预计这两版仍会失败。
MODEL_KEY=m2.7-recipe-tp8ep
MODEL_HOST=/data/liuxin/Ax/models/MiniMax_MiniMax-M2.7
SERVED_NAME=m2.7
PARALLEL_NAME="TP8+EP"
PARALLEL_ARGS="--tensor-parallel-size 8 --enable-expert-parallel"
RECIPE_ARGS="--trust-remote-code --tool-call-parser minimax_m2 --reasoning-parser minimax_m2 --enable-auto-tool-choice"
EXTRA_SERVE_ARGS="--disable-custom-all-reduce"
OUTPUT_ROOT=/data/liuxin/bifrost/bench/m2.7-recipe-tp8ep

IN_LEN=2048
OUT_LEN=1024
NUM_PROMPTS=100
CONCURRENCY=10
