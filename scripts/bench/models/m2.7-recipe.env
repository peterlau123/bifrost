# MiniMax-M2.7 · 官方 recipe 的 benchmark 负载（2048 in / 1024 out / 并发 10 / 100 prompts）
# 与 m2.7.env 的唯一差别就是负载，用于和 vLLM 官方数字、别人的记录对齐。
MODEL_KEY=m2.7-recipe
MODEL_HOST=/data/liuxin/Ax/models/MiniMax_MiniMax-M2.7
SERVED_NAME=m2.7
PARALLEL_NAME="TP4"
PARALLEL_ARGS="--tensor-parallel-size 4"
RECIPE_ARGS="--trust-remote-code --tool-call-parser minimax_m2 --reasoning-parser minimax_m2 --enable-auto-tool-choice"
EXTRA_SERVE_ARGS="--disable-custom-all-reduce"
OUTPUT_ROOT=/data/liuxin/bifrost/bench/m2.7-recipe

# recipe benchmark 段原样取值
IN_LEN=2048
OUT_LEN=1024
NUM_PROMPTS=100
CONCURRENCY=10
